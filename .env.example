# Clave privada. Genera una larga y aleatoria, por ejemplo:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
FUTBIN_API_KEY=change-me

# Servidor
HOST=127.0.0.1
PORT=8787

# Futbin
FUTBIN_GAME_VERSION=27
FUTBIN_BASE_URL=https://www.futbin.com
FUTBIN_FETCHER=auto
# FUTBIN_COOKIE=
# FUTBIN_PROXY=
# FUTBIN_CURL_PATH=curl

# Actualización automática de precios
PRICE_AUTO_REFRESH=true
PRICE_REFRESH_INTERVAL_SECONDS=60
PRICE_REFRESH_TICK_SECONDS=15
PRICE_REFRESH_BATCH_SIZE=3
PRICE_REFRESH_MAX_TRACKED=20
PRICE_REFRESH_TRACK_TTL_SECONDS=900
# PRICE_WATCH_PLAYERS=8,22

# Red y caché
REQUEST_TIMEOUT_MS=25000
FUTBIN_MAX_RETRIES=2
UPSTREAM_CONCURRENCY=4
RATE_LIMIT_PER_MIN=60
CACHE_MAX_ENTRIES=400
CACHE_TTL_PLAYERS=120
CACHE_TTL_PLAYER=60
CACHE_TTL_PRICES=45
CACHE_TTL_SEARCH=120
CACHE_TTL_HOVER=90

# Opcionales
# CORS_ORIGIN=http://localhost:3000
# TRUST_PROXY=false
# LOG_LEVEL=info
# FUTBIN_ALLOW_NO_KEY=false
